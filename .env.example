# ============================================================================
# ZYRO — Personal AI Assistant Environment Configuration
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# 1. Google AI (@google/genai) Server-Side Configuration
# ----------------------------------------------------------------------------
# Required for AI conversation, reasoning, and embeddings (Server-side only)
GEMINI_API_KEY=

# Configurable Model IDs (Validated against supported Google AI models)
ZYRO_CHAT_MODEL=gemini-3.5-flash-lite
ZYRO_REASONING_MODEL=gemini-3.5-flash
ZYRO_EMBEDDING_MODEL=gemini-embedding-2-preview
ZYRO_TTS_MODEL=gemini-3.8-flash-lite-tts
ZYRO_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# ----------------------------------------------------------------------------
# 2. Firebase Authentication & Cloud Firestore Persistence (Project: zyro-a3482)
# ----------------------------------------------------------------------------
# Target Firebase Project ID
FIREBASE_PROJECT_ID=zyro-a3482
FIREBASE_DATABASE_ID=(default)

# Option A (Recommended for Local Development):
# Path to a Firebase Admin service-account JSON file stored inside the git-ignored secrets/ directory
GOOGLE_APPLICATION_CREDENTIALS=./secrets/zyro-a3482-service-account.json

# Option B (Recommended for Cloud Hosting / Secret Managers):
# Discrete service-account credentials or inline JSON string
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Client-Side Firebase Web Auth Configuration (Public Web App Identifiers Only)
VITE_FIREBASE_PROJECT_ID=zyro-a3482
VITE_FIREBASE_AUTH_DOMAIN=zyro-a3482.firebaseapp.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
