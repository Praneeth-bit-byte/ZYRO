# ============================================================================
# ZYRO — Personal AI Assistant Environment Configuration
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# 1. Google AI (@google/genai) Server-Side Configuration
# ----------------------------------------------------------------------------
# Required for AI conversation, reasoning, and embeddings (Server-side only)
GEMINI_API_KEY=

# Configurable Model IDs (Validated against supported Google AI models)
ZYRO_CHAT_MODEL=gemini-3.5-flash-lite
ZYRO_REASONING_MODEL=gemini-3.5-flash
ZYRO_EMBEDDING_MODEL=gemini-embedding-2-preview
ZYRO_TTS_MODEL=gemini-3.8-flash-lite-tts
ZYRO_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# ----------------------------------------------------------------------------
# 2. Firebase Authentication & Cloud Firestore Persistence Configuration
# ----------------------------------------------------------------------------
# Server-side Firestore & Auth Verification
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client-side Firebase Web/Cross-Platform Auth SDK Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
